{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://github.com/1DeliDolu/pehlione.io./portfolio/",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm run server\"",
    "dev:web": "vite",
    "server": "node server/server.js",
    "db": "node -e \"console.log('Use npm run server; the data API now runs on Express port 3001.')\"",
    "generate:photos": "tsx scripts/generatePhotos.ts",
    "generate:static": "tsx scripts/generateStaticData.ts",
    "optimize:originals": "node scripts/optimize-originals.mjs",
    "build": "npm run thumbs && npm run generate:photos && npm run generate:static && tsc -b && vite build && node scripts/copy-blog-entry.mjs",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "typecheck": "tsc -b",
    "test": "node --test server/tests/*.test.js",
    "thumbs": "node scripts/gen-thumbs.mjs",
    "test:e2e": "node scripts/run-playwright.mjs test --project=chromium --project=firefox",
    "test:e2e:webkit": "node scripts/run-playwright.mjs test --project=webkit",
    "test:e2e:all": "node scripts/run-playwright.mjs test",
    "test:e2e:ui": "node scripts/run-playwright.mjs test --ui",
    "test:e2e:headed": "node scripts/run-playwright.mjs test --headed"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.7",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@mui/styled-engine-sc": "^7.3.2",
    "@tailwindcss/vite": "^4.1.13",
    "axios": "^1.12.2",
    "bootstrap": "^5.3.8",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.1.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.1.19",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-react": "^5.0.0",
    "baseline-browser-mapping": "^2.9.14",
    "commitlint": "^19.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^6.3.0",
    "globals": "^16.4.0",
    "json-server": "^1.0.0-beta.3",
    "sharp": "^0.33.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.2"
  }
}
